// Prisma schema for Results admin dashboard (PostgreSQL via driver adapter)
// Run: npx prisma generate

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model AdminShelter {
  id              String   @id @default(cuid())
  name            String
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  zipCode         String?
  country         String?  @default("United States")
  capacity        Int?
  currentOccupancy Int?    @default(0)
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  description     String?
  website         String?
  operatingHours  String?
  notes           String?
  facilities      Json?
  status          String?  @default("active")
  type            String?
  coordinates     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
