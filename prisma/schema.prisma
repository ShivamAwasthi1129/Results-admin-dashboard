// Prisma schema for Results admin dashboard
// URL is configured via prisma.config.ts (Prisma 7)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  subtitle        String?
  type            String
  category        String?
  status          String             @default("DRAFT")
  fontStyle       String?            @default("Classic")
  primaryColor    String?            @default("#991B1B")
  colorMode       String?            @default("Light")
  backgroundStyle String?            @default("Simple")
  backgroundTheme String?
  organization    String?
  location        String?
  startDate       DateTime?
  endDate         DateTime?
  salesOpenDate   DateTime?
  salesCloseDate  DateTime?
  recurrence      String?            @default("once")
  description     String?
  bannerUrl       String?
  bannerPublicId  String?
  bannerType      String?            @default("image")
  logoUrl         String?
  logoPublicId    String?
  goalAmount      Float?
  raisedAmount    Float?             @default(0)
  donationConfig  Json?
  seoData         Json?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  media           CampaignMedia[]
  donations       CampaignDonation[]
}

model CampaignMedia {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        String
  url         String
  publicId    String
  altText     String?
  category    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
}

model CampaignDonation {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donorFirstName    String?
  donorLastName     String?
  donorEmail        String?
  donorPhone        String?
  amount            Float
  currency          String   @default("usd")
  recurring         Boolean  @default(false)
  recurringInterval String?
  stripeSessionId   String?
  stripePaymentId   String?
  status            String   @default("pending")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminShelter {
  id              String   @id @default(cuid())
  name            String
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  zipCode         String?
  country         String?  @default("United States")
  capacity        Int?
  currentOccupancy Int?    @default(0)
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  description     String?
  website         String?
  operatingHours  String?
  notes           String?
  facilities      Json?
  status          String?  @default("active")
  type            String?
  coordinates     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}